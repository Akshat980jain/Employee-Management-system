# Database (MongoDB)
DATABASE_URL="mongodb://localhost:27017/ems_db"

# JWT
JWT_ACCESS_SECRET="ems-access-secret-key-change-in-production"
JWT_REFRESH_SECRET="ems-refresh-secret-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Brevo Email Configuration
BREVO_API_KEY="your_brevo_api_key_here"
BREVO_SENDER_EMAIL="noreply@staffsphere.com"
BREVO_SENDER_NAME="StaffSphere System"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_here" # Paste your WEB Client ID here (Required for token verification)
# GOOGLE_ANDROID_CLIENT_ID="your_android_client_id_here" # Paste your ANDROID Client ID here (Optional, for reference only)
