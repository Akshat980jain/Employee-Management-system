# Prevent caching of index.html so browsers always get the latest chunk references
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Allow long caching for hashed assets (they have unique filenames per build)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
